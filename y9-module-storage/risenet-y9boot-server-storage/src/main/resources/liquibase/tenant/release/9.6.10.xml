<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="170200140583810-1-1" author="yihong" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="Y9_STORAGE_TAG"/>
            </not>
        </preConditions>
        <createTable remarks="文件标签表"
                     tableName="Y9_STORAGE_TAG">
            <column name="ID" remarks="主键id" type="VARCHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="CREATETIME" remarks="创建时间" type="datetime">
            </column>
            <column name="UPDATETIME" remarks="更新时间" type="datetime">
            </column>
            <column name="TAGNAME" remarks="标签名称" type="VARCHAR(100)">
            </column>
            <column name="TAGTYPE" remarks="标签类型" type="VARCHAR(50)">
            </column>
            <column name="TAGCOLOR" remarks="标签颜色" type="VARCHAR(50)">
            </column>
            <column name="CREATEID" remarks="创建人id" type="VARCHAR(38)">
            </column>
            <column name="CREATENAME" remarks="创建人姓名" type="VARCHAR(50)">
            </column>
            <column name="TABINDEX" remarks="排序字段" type="INT">
            </column>
        </createTable>
    </changeSet>

    <changeSet id="170200140583810-1-2" author="yihong" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="Y9_STORAGE_TAG_RELATION"/>
            </not>
        </preConditions>
        <createTable remarks="文件标签关联表"
                     tableName="Y9_STORAGE_TAG_RELATION">
            <column name="ID" remarks="主键id" type="VARCHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="FILEID" remarks="文件id" type="VARCHAR(50)">
            </column>
            <column name="TAGID" remarks="标签id" type="VARCHAR(50)">
            </column>
            <column name="OPERATORID" remarks="操作人id" type="VARCHAR(50)">
            </column>
            <column name="OPERATETIME" remarks="操作时间" type="datetime">
            </column>
        </createTable>
    </changeSet>

    <changeSet id="170200140583810-1-3" author="yihong" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="Y9_STORAGE_TAG" columnName="DESCRIPTION"/>
            </not>
        </preConditions>
        <addColumn tableName="Y9_STORAGE_TAG">
            <column name="DESCRIPTION" remarks="标签描述" type="VARCHAR(200)"/>
        </addColumn>
    </changeSet>

    <changeSet id="170200140583810-1-4" author="yihong">
        <addUniqueConstraint
                tableName="Y9_STORAGE_CAPACITY"
                columnNames="CAPACITYOWNERID"
                constraintName="UK_CAPACITYOWNERID"/>
    </changeSet>

    <changeSet id="170200140583810-1-5" author="yihong" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="Y9_STORAGE_SHARE_LINK" columnName="BROWSECOUNT"/>
            </not>
        </preConditions>
        <addColumn tableName="Y9_STORAGE_SHARE_LINK">
            <column name="BROWSECOUNT" remarks="浏览次数" type="INT"/>
        </addColumn>
    </changeSet>

    <changeSet id="170200140583810-1-6" author="yihong" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="Y9_STORAGE_SHARE_LINK" columnName="VALIDPERIOD"/>
            </not>
        </preConditions>
        <addColumn tableName="Y9_STORAGE_SHARE_LINK">
            <column name="VALIDPERIOD" remarks="有效期设置" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="170200140583810-1-7" author="yihong" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="Y9_STORAGE_SHARE_LINK" columnName="EXPIRETIME"/>
            </not>
        </preConditions>
        <addColumn tableName="Y9_STORAGE_SHARE_LINK">
            <column name="EXPIRETIME" remarks="到期时间" type="DATE"/>
        </addColumn>
    </changeSet>

    <changeSet id="170200140583810-1-8" author="yihong" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="Y9_STORAGE_AI_CHAT_SESSION"/>
            </not>
        </preConditions>
        <createTable remarks="AI对话会话表"
                     tableName="Y9_STORAGE_AI_CHAT_SESSION">
            <column name="ID" remarks="主键id" type="VARCHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="PERSON_ID" remarks="用户ID" type="VARCHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="TENANT_ID" remarks="租户ID" type="VARCHAR(38)">
            </column>
            <column name="TITLE" remarks="会话标题" type="VARCHAR(500)">
            </column>
            <column name="CREATE_TIME" remarks="创建时间" type="datetime">
            </column>
            <column name="UPDATE_TIME" remarks="更新时间" type="datetime">
            </column>
        </createTable>
    </changeSet>

    <changeSet id="170200140583810-1-9" author="yihong" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="Y9_STORAGE_AI_CHAT_MESSAGE"/>
            </not>
        </preConditions>
        <createTable remarks="AI对话消息表"
                     tableName="Y9_STORAGE_AI_CHAT_MESSAGE">
            <column name="ID" remarks="主键id" type="VARCHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="SESSION_ID" remarks="会话ID" type="VARCHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="ROLE" remarks="角色：user-用户 assistant-AI" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="CONTENT" remarks="消息内容" type="TEXT">
            </column>
            <column name="CREATE_TIME" remarks="创建时间" type="datetime">
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>